{
    "require": {
        "php": ">=7.2",
        "cleantalk/antispam": "*",
        "cleantalk/firewall": "*",
        "cleantalk/dns": "*",
        "cleantalk/api": "*",
        "cleantalk/cron": "*",
        "cleantalk/remote-calls": "*",
        "cleantalk/storage-handler": "*",
        "cleantalk/rate-limiter": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.52",
        "squizlabs/php_codesniffer": "3.*",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "scripts": {
        "test": [
            "@test:phpcs",
            "@test:phpunit"
        ],
        "test:phpcs": "@php vendor/bin/phpcs --standard=tests/.phpcs.xml --runtime-set installed_paths vendor/phpcompatibility/php-compatibility",
        "test:phpunit": "@php vendor/bin/phpunit --configuration=tests/phpunit.xml"
    },
    "config": {
        "platform": {
            "php": "7.2.0"
        },
        "allow-plugins": {
            "cleantalk/apbct-installer": true
        }
    }
}
